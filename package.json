{
  "name": "@nippur72/crt-emulator",
  "version": "1.5.0",
  "description": "CRT screen emulation (old color TV set) class written in TypeScript and WebGL",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "prepare": "npm run build",
    "demo": "http-server . -p 8080 -c-1"
  },
  "keywords": [
    "crt",
    "emulator",
    "webgl",
    "scanlines",
    "retro",
    "shader",
    "canvas",
    "tv"
  ],
  "author": "nippur72",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nippur72/crt-emulator.git"
  },
  "bugs": {
    "url": "https://github.com/nippur72/crt-emulator/issues"
  },
  "homepage": "https://github.com/nippur72/crt-emulator#readme",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "http-server": "^14.1.1",
    "typescript": "^5.0.0"
  }
}
